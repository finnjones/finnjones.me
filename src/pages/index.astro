---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Shot from '../components/Shot.astro';
import { workImage, portraitImage } from '../lib/images';
import { profile, projects, years, hostname, liveLink } from '../lib/profile';

const lead = projects.filter((p) => p.lead);
const earlier = projects.filter((p) => !p.lead);
---

<BaseLayout>
  <section class="hero band">
    <div class="page hero-inner">
      <div class="grid hero-top">
        <div class="hero-text">
          {profile.intro.map((para) => <p class="lead">{para}</p>)}
        </div>
        <Image
          src={portraitImage}
          alt="Finn Jones in sunglasses and a cap, standing at a street market."
          width={960}
          widths={[400, 640, 960]}
          sizes="(max-width: 60rem) 60vw, 20rem"
          class="shot hero-photo"
          loading="eager"
        />
      </div>
      <h1 class="hero-name">{profile.name}</h1>
    </div>
  </section>

  <div class="stages" id="work">
    {
      lead.map((p, i) => (
        <article class="stage band" style={`--bg:${p.color};--fg:${p.ink}`}>
          <div class="page grid stage-inner">
            <h2 class="stage-title" style={`view-transition-name:title-${p.slug}`}>
              <a href={`/work/${p.slug}`}>{p.title}</a>
            </h2>
            <div class="stage-text">
              <p class="lead">{p.summary}</p>
              <p class="stage-meta">
                {p.year}. Built with {p.tech.slice(0, 4).join(', ')}.
              </p>
              <ul class="links">
                <li><a href={`/work/${p.slug}`}>How it works</a></li>
                {liveLink(p) && <li><a href={liveLink(p)}>{hostname(liveLink(p)!)}</a></li>}
                {p.repo && <li><a href={p.repo}>Source on GitHub</a></li>}
              </ul>
            </div>
            <a class="stage-shot" href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true">
              <Shot project={p} sizes="(max-width: 60rem) 92vw, 54vw" eager={i === 0} />
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <section class="page earlier">
    <h2 class="section-title">Earlier work</h2>
    <ul class="earlier-list">
      {
        earlier.map((p) => (
          <li>
            <a class="earlier-row" href={`/work/${p.slug}`} style={`--hover:${p.color}`}>
              <span class="earlier-year">{p.year}</span>
              <span class="earlier-name">{p.title}</span>
              <span class="earlier-summary">{p.summary}</span>
              {workImage(p.image) && (
                <span class="earlier-thumb">
                  <Shot project={p} sizes="12rem" />
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page grid about" id="about">
    <div class="about-text">
      <h2 class="section-title">About</h2>
      <p class="lead">{profile.about[0]}</p>
      <p class="about-more"><a href="/about">More about me</a></p>
    </div>
    <ul class="rows about-rows">
      {
        profile.experience.map((e) => (
          <li>
            <span class="when">{years(e.start, e.end)}</span>
            <span>
              <strong>{e.role}</strong>
              <br />
              {e.company}
            </span>
          </li>
        ))
      }
      {
        profile.education.map((e) => (
          <li>
            <span class="when">{years(e.start, e.end)}</span>
            <span>
              <strong>{e.degree}</strong>
              <br />
              {e.institution}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* ---- Hero: a yellow field, the introduction, and the name at full width ---- */
  .hero {
    --bg: var(--sun);
    position: relative;
    z-index: 2;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2.5rem, 6vw, 5rem);
    min-height: calc(100svh - var(--rail) - 5rem);
    padding-block: clamp(1rem, 3vw, 2.5rem) 0;
  }
  .hero-top {
    row-gap: 2rem;
    align-items: start;
  }
  .hero-text {
    max-width: 44rem;
  }
  .hero-text .lead + .lead {
    margin-top: 0.75em;
  }
  .hero-photo {
    width: min(60%, 16rem);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 78% 40%;
  }
  @media (min-width: 60rem) {
    .hero-text {
      grid-column: 1 / span 7;
    }
    .hero-photo {
      grid-column: 10 / span 3;
      width: 100%;
    }
  }
  .hero-name {
    margin-left: -0.045em;
    font-size: var(--size-giant);
    line-height: 0.8;
    letter-spacing: -0.06em;
    white-space: nowrap;
    padding-bottom: 0.08em;
  }

  /* ---- Stages: one field of colour per project ---- */
  .stage {
    position: relative;
    z-index: 2;
  }
  .stage-inner {
    row-gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .stage-title {
    font-size: clamp(2.75rem, 0.5rem + 9.2vw, 9.5rem);
    line-height: 0.85;
    letter-spacing: -0.055em;
    margin-left: -0.04em;
    overflow-wrap: anywhere;
  }
  .stage-title a {
    text-decoration: none;
  }
  .stage-meta {
    margin-block: 1rem 1.5rem;
  }
  .stage-shot {
    display: block;
  }
  .stage-shot:hover {
    background: none;
  }
  @media (min-width: 60rem) {
    .stage-text {
      grid-column: 1 / span 5;
      align-self: end;
    }
    .stage-shot {
      grid-column: 6 / span 7;
      justify-self: end;
      /* Never taller than half the screen, so a pinned stage always fits. */
      width: min(100%, 52svh * 1.6);
    }
  }
  /* On a screen tall enough to hold one, each stage sticks under the rail
     and the next slides up over it. */
  @media (min-width: 60rem) and (min-height: 44rem) {
    .stage {
      position: sticky;
      top: var(--rail);
      display: flex;
      align-items: center;
      min-height: calc(100svh - var(--rail));
    }
    .stage-inner {
      padding-block: 1.5rem;
    }
  }

  /* ---- Sections on white ---- */
  .earlier,
  .about {
    padding-block: clamp(4rem, 9vw, 8rem) 0;
  }
  .section-title {
    font-size: var(--size-title);
    margin-bottom: 0.4em;
  }

  .earlier-list {
    list-style: none;
    border-top: var(--stroke) solid var(--ink);
  }
  .earlier-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5.5rem;
    gap: 0.25rem var(--gap);
    align-items: center;
    padding-block: 1.25rem;
    border-bottom: var(--stroke) solid var(--ink);
    text-decoration: none;
  }
  .earlier-row:hover {
    background: var(--hover);
    color: var(--ink);
  }
  .earlier-name {
    grid-column: 1;
    font-size: clamp(1.75rem, 1rem + 2.6vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .earlier-year {
    grid-column: 1;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .earlier-summary {
    grid-column: 1;
  }
  .earlier-thumb {
    grid-column: 2;
    grid-row: 1 / span 3;
  }
  @media (min-width: 60rem) {
    .earlier-row {
      grid-template-columns: 5rem minmax(0, 5fr) minmax(0, 5fr) 11rem;
      padding-inline: 0.75rem;
    }
    .earlier-year,
    .earlier-name,
    .earlier-summary,
    .earlier-thumb {
      grid-column: auto;
      grid-row: auto;
    }
  }

  .about {
    row-gap: 2.5rem;
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }
  .about-more {
    margin-top: 1.5rem;
    font-weight: 650;
  }
  @media (min-width: 60rem) {
    .about-text {
      grid-column: 1 / span 6;
    }
    .about-rows {
      grid-column: 8 / span 5;
      align-self: end;
    }
  }
</style>
