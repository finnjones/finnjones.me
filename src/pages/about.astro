---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../lib/profile';
import { portraitImage } from '../lib/images';

function range(start: string, end: string) {
  if (!start && !end) return '';
  return `${start || '—'} → ${end || 'Present'}`;
}
---

<BaseLayout title="About" description={`About ${profile.name} — ${profile.headline}.`}>
  <section class="about-hero">
    <div class="wrap">
      <nav class="about-crumb mono-sm" aria-label="Breadcrumb">
        <a href="/" class="accent">← HOME</a>
        <span class="muted">/ ABOUT</span>
      </nav>

      <div class="about-top">
        <div class="about-intro">
          <span class="mono-sm muted">// PROFILE — {profile.name.toUpperCase()}</span>
          <h1 class="about-title" data-split>
            A software engineer who <span class="serif">speaks</span> finance.
          </h1>
          <div class="about-text">
            {profile.about.map((p) => <p>{p}</p>)}
          </div>
          <div class="about-ctas">
            <a href="/#contact" class="btn btn-solid" data-magnetic>Get in touch</a>
            <a href="/#work" class="btn" data-magnetic>See the work ↓</a>
          </div>
        </div>

        <figure class="about-portrait" data-reveal>
          <Image
            src={portraitImage}
            alt={`Portrait of ${profile.name}`}
            widths={[320, 480, 640]}
            sizes="(max-width: 880px) 70vw, 400px"
            class="about-portrait-img"
          />
          <figcaption class="mono-sm muted">
            <span class="accent">●</span> {profile.location.toUpperCase()}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="section-idx">01</span>
        <h2 class="section-title" data-split>Where I've worked</h2>
      </div>
      <ol class="about-list" data-stagger>
        {
          profile.experience.map((e) => (
            <li class="about-row">
              <span class="about-years mono tabular">{range(e.start, e.end)}</span>
              <div class="about-row-main">
                <h3 class="about-role">{e.role}</h3>
                <span class="about-co muted">
                  {e.company}
                  {e.location ? ` · ${e.location}` : ''}
                </span>
                <ul class="about-highlights">
                  {e.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="section-idx">02</span>
        <h2 class="section-title" data-split>Where I've studied</h2>
      </div>
      <ol class="about-list" data-stagger>
        {
          profile.education.map((e) => (
            <li class="about-row">
              <span class="about-years mono tabular">{range(e.start, e.end)}</span>
              <div class="about-row-main">
                <h3 class="about-role">{e.degree}</h3>
                <span class="about-co muted">{e.institution}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-top: calc(var(--bar-h) + clamp(2rem, 6vw, 4rem));
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }
  .about-crumb {
    display: flex;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 6vw, 3.5rem);
  }
  :root[data-theme='paper'] .about-crumb .accent {
    color: var(--accent-text);
  }
  .about-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .about-title {
    font-size: var(--fs-display);
    font-weight: 660;
    letter-spacing: -0.04em;
    line-height: 0.98;
    margin: 1rem 0 2rem;
    max-width: 16ch;
  }
  .about-title .serif {
    font-size: 1.1em;
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--muted);
    max-width: 56ch;
    font-size: var(--fs-body-lg);
  }
  .about-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .about-portrait-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 82% 42%;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    filter: grayscale(0.55) contrast(1.02);
    transition: filter 0.5s var(--ease-out);
  }
  .about-portrait:hover .about-portrait-img {
    filter: grayscale(0);
  }
  .about-portrait figcaption {
    margin-top: 0.75rem;
  }

  .about-list {
    list-style: none;
  }
  .about-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--rule);
  }
  .about-row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .about-years {
    color: var(--accent);
    font-size: 0.74rem;
    padding-top: 0.4rem;
  }
  :root[data-theme='paper'] .about-years {
    color: var(--accent-text);
  }
  .about-role {
    font-size: var(--fs-h3);
    font-weight: 540;
    letter-spacing: -0.02em;
  }
  .about-co {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.92rem;
  }
  .about-highlights {
    list-style: none;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .about-highlights li {
    padding-left: 1.3rem;
    position: relative;
  }
  .about-highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  :root[data-theme='paper'] .about-highlights li::before {
    color: var(--accent-text);
  }

  @media (max-width: 880px) {
    .about-top {
      grid-template-columns: 1fr;
    }
    .about-portrait {
      max-width: 280px;
      order: -1;
    }
  }
  @media (max-width: 520px) {
    .about-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
