---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { portraitImage } from '../lib/images';
import { profile, years } from '../lib/profile';
---

<BaseLayout title="About" description={profile.about[0]}>
  <section class="band about-head">
    <div class="page grid about-head-inner">
      <h1 class="about-title">About</h1>
      <div class="about-text">
        <p class="lead">{profile.about[0]}</p>
        {profile.about.slice(1).map((para) => <p class="about-para">{para}</p>)}
      </div>
      <Image
        src={portraitImage}
        alt="Finn Jones in sunglasses and a cap, standing at a street market."
        width={1200}
        widths={[480, 800, 1200]}
        sizes="(max-width: 60rem) 92vw, 30rem"
        class="shot about-photo"
        loading="eager"
      />
    </div>
  </section>

  <section class="page grid about-section">
    <h2 class="about-section-title">Experience</h2>
    <ul class="rows about-rows">
      {
        profile.experience.map((e) => (
          <li>
            <span class="when">{years(e.start, e.end)}</span>
            <div>
              <strong>{e.role}</strong>
              <br />
              {e.company}
              {e.location ? `, ${e.location}` : ''}
              {e.highlights.length > 0 && (
                <ul class="points">
                  {e.highlights.map((h) => <li>{h}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page grid about-section">
    <h2 class="about-section-title">Education</h2>
    <ul class="rows about-rows">
      {
        profile.education.map((e) => (
          <li>
            <span class="when">{years(e.start, e.end)}</span>
            <span>
              <strong>{e.degree}</strong>
              <br />
              {e.institution}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page grid about-section about-last">
    <h2 class="about-section-title">Skills</h2>
    <ul class="rows about-rows">
      {
        profile.capabilities.map((c) => (
          <li>
            <span class="when">{c.label}</span>
            <span>{c.items.join(', ')}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .about-head {
    --bg: var(--sun);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .about-head-inner {
    row-gap: 2rem;
    align-items: start;
    padding-top: clamp(1.5rem, 5vw, 4rem);
  }
  .about-title {
    font-size: clamp(3.25rem, 1rem + 11vw, 13rem);
    line-height: 0.85;
    letter-spacing: -0.055em;
    margin-left: -0.04em;
  }
  .about-para {
    max-width: 42rem;
    margin-top: 1.25rem;
    font-size: 1.25rem;
  }
  .about-photo {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  @media (min-width: 60rem) {
    .about-text {
      grid-column: 1 / span 7;
    }
    .about-photo {
      grid-column: 9 / span 4;
      aspect-ratio: 4 / 5;
      object-position: 78% 40%;
    }
  }

  .about-section {
    row-gap: 1.25rem;
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }
  .about-last {
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }
  .about-section-title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
  }
  @media (min-width: 60rem) {
    .about-section-title {
      grid-column: 1 / span 4;
    }
    .about-rows {
      grid-column: 5 / span 8;
    }
  }

  .points {
    margin-top: 0.5rem;
    padding-left: 1.1em;
    list-style: disc;
  }
  .points li + li {
    margin-top: 0.25rem;
  }
</style>
