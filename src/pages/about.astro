---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { portraitImage } from '../lib/images';
import { profile, years } from '../lib/profile';
---

<BaseLayout title="About" description={profile.about[0]}>
  <section class="page grid about-head">
    <div class="about-text">
      <h1 class="about-title">About</h1>
      {profile.about.map((para) => <p class="about-para">{para}</p>)}
    </div>
    <Image
      src={portraitImage}
      alt="Finn Jones in sunglasses and a cap, standing at a street market."
      width={1200}
      widths={[480, 800, 1200]}
      sizes="(max-width: 60rem) 92vw, 30rem"
      class="shot about-photo"
      loading="eager"
    />
  </section>

  <section class="page grid section">
    <h2 class="section-title side">Experience</h2>
    <ul class="rows main">
      {
        profile.experience.map((e) => (
          <li>
            <span class="when">{years(e.start, e.end)}</span>
            <div>
              <strong>{e.role}</strong>
              <br />
              {e.company}
              {e.location ? `, ${e.location}` : ''}
              {e.highlights.length > 0 && (
                <ul class="points">
                  {e.highlights.map((h) => <li>{h}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page grid section">
    <h2 class="section-title side">Education</h2>
    <ul class="rows main">
      {
        profile.education.map((e) => (
          <li>
            <span class="when">{years(e.start, e.end)}</span>
            <span>
              <strong>{e.degree}</strong>
              <br />
              {e.institution}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page grid section">
    <h2 class="section-title side">Skills</h2>
    <ul class="rows main">
      {
        profile.capabilities.map((c) => (
          <li>
            <span class="when">{c.label}</span>
            <span>{c.items.join(', ')}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page grid section">
    <h2 class="section-title side">Contact</h2>
    <div class="main">
      <p class="lead about-email"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      <ul class="links">
        {profile.socials.filter((s) => s.label !== 'Email').map((s) => <li><a href={s.url}>{s.label}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head {
    margin-top: clamp(2rem, 6vw, 5rem);
    row-gap: 2rem;
    align-items: start;
  }
  .about-title {
    font-size: var(--size-lead);
    margin-bottom: 1.5rem;
  }
  .about-para {
    max-width: 40rem;
    font-size: var(--size-text);
    line-height: 1.55;
  }
  .about-para + .about-para {
    margin-top: 1.25rem;
  }
  .about-photo {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  @media (min-width: 60rem) {
    .about-text {
      grid-column: 1 / span 7;
    }
    .about-photo {
      grid-column: 9 / span 4;
      aspect-ratio: 4 / 5;
      object-position: 78% 40%;
      margin-top: 0.4rem;
    }
  }

  .points {
    margin-top: 0.5rem;
    padding-left: 1.1em;
    list-style: disc;
    color: var(--ink-soft);
  }
  .points li + li {
    margin-top: 0.25rem;
  }

  .about-email {
    margin-bottom: 1rem;
    overflow-wrap: anywhere;
  }
</style>
