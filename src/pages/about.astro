---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Stops from '../components/Stops.astro';
import { portraitImage } from '../lib/images';
import { profile, years } from '../lib/profile';

const jobs = profile.experience.map((e) => ({
  title: e.role,
  when: years(e.start, e.end),
  place: [e.company, e.location].filter(Boolean).join(', '),
  points: e.highlights,
  now: e.end === 'Present',
}));
const study = profile.education.map((e) => ({
  title: e.degree,
  when: years(e.start, e.end),
  place: e.institution,
}));
---

<BaseLayout title="About" description={profile.about[0]}>
  <section class="band about-head">
    <div class="page about-head-inner">
      <h1 class="about-title">About</h1>
      <div class="about-text">
        <p class="about-lead">{profile.about[0]}</p>
        {profile.about.slice(1).map((para) => <p class="about-para">{para}</p>)}
      </div>
      <Image
        src={portraitImage}
        alt="Finn Jones in sunglasses and a cap, standing at a street market."
        width={1200}
        widths={[480, 800, 1200]}
        sizes="(max-width: 60rem) 92vw, 30rem"
        class="shot about-photo"
        loading="eager"
      />
    </div>
  </section>

  <section class="page about-section">
    <h2 class="about-section-title">Experience</h2>
    <Stops stops={jobs} ground="var(--paper)" />
  </section>

  <section class="page about-section">
    <h2 class="about-section-title">Education</h2>
    <Stops stops={study} ground="var(--paper)" />
  </section>

  <section class="page about-section about-last">
    <h2 class="about-section-title">Skills</h2>
    <dl class="skills">
      {
        profile.capabilities.map((c) => (
          <div>
            <dt>{c.label}</dt>
            <dd>{c.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>

<style>
  .about-head {
    --bg: var(--sun);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .about-head-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-top: clamp(1rem, 4vw, 3rem);
  }
  .about-title {
    grid-column: 1 / -1;
    font-size: clamp(3.25rem, 1rem + 11vw, 13rem);
    line-height: 0.85;
  }
  .about-lead {
    font-family: var(--pixel);
    font-size: clamp(1.375rem, 1rem + 1.2vw, 2.125rem);
    line-height: 1.25;
  }
  .about-para {
    max-width: 42rem;
    margin-top: 1.5rem;
    font-size: 1.25rem;
  }
  .about-photo {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 78% 40%;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 1.25rem var(--gap);
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }
  .about-last {
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }
  .about-section-title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
  }

  /* Skills on a board panel. */
  .skills {
    background: #0c0c0a;
    color: #f3ecd8;
    border: var(--stroke) solid #0c0c0a;
    outline: var(--stroke) solid #3d3d38;
    outline-offset: calc(var(--stroke) * -2);
    padding: 0.5rem 1.5rem;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
  }
  .skills > div + div {
    border-top: 2px dashed #3d3d38;
  }
  .skills dt {
    font-family: var(--label);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: #a3a092;
    padding-top: 0.35em;
  }
  .skills dd {
    font-family: var(--pixel);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  @media (max-width: 60rem) {
    .about-head-inner,
    .about-section {
      grid-template-columns: 1fr;
    }
    .about-photo {
      aspect-ratio: 3 / 2;
    }
  }
  @media (max-width: 30rem) {
    .skills > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
