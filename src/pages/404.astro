---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../lib/profile';
---

<BaseLayout title="Page not found">
  <section class="band not-found">
    <div class="page">
      <h1>This train does not stop here.</h1>
      <p class="lead">
        There is no page at this address. Go to the <a href="/">home page</a>, or straight to a project:
      </p>
      <ul class="links">
        {projects.map((p) => <li><a href={`/work/${p.slug}`}>{p.title}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    --bg: var(--sun);
    padding-block: clamp(2rem, 6vw, 5rem) clamp(4rem, 9vw, 8rem);
  }
  .not-found h1 {
    font-size: var(--size-title);
    margin-bottom: 0.4em;
  }
  .not-found p {
    max-width: 40rem;
    margin-bottom: 1.25rem;
  }
</style>
