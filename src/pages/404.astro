---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Position not found" noFooter={true}>
  <section class="nf">
    <canvas class="nf-field" data-hero-field aria-hidden="true"></canvas>
    <div class="nf-inner wrap">
      <span class="mono-sm nf-tag">ERR 404 · POSITION NOT FOUND</span>
      <h1 class="nf-code">404</h1>
      <p class="nf-msg">
        This entry isn't on the <span class="serif">ledger</span>. The page you're after has been
        moved, delisted, or never existed.
      </p>
      <div class="nf-ctas">
        <a href="/" class="btn btn-solid" data-magnetic>← Back to index</a>
        <a href="/#work" class="btn" data-magnetic>Selected work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHeroField } from '../scripts/hero-field.ts';
  let destroy: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    destroy?.();
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-field]');
    if (canvas) destroy = initHeroField(canvas);
  });
  document.addEventListener('astro:before-swap', () => {
    destroy?.();
    destroy = null;
  });
</script>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding-top: var(--bar-h);
  }
  .nf-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .nf-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    pointer-events: none;
  }
  .nf-inner a {
    pointer-events: auto;
  }
  .nf-tag {
    color: var(--accent);
    letter-spacing: 0.16em;
  }
  :root[data-theme='paper'] .nf-tag {
    color: var(--accent-text);
  }
  .nf-code {
    font-size: var(--fs-mega);
    font-weight: 720;
    letter-spacing: -0.05em;
    line-height: 0.9;
    margin: 0.5rem 0 1.5rem;
  }
  .nf-msg {
    font-size: var(--fs-body-lg);
    color: var(--muted);
    max-width: 40ch;
    margin-inline: auto;
  }
  .nf-msg .serif {
    color: var(--fg);
    font-size: 1.1em;
  }
  .nf-ctas {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2.5rem;
  }
</style>
