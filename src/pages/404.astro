---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../lib/profile';
---

<BaseLayout title="Page not found">
  <section class="page not-found">
    <h1 class="lead">There is no page at this address.</h1>
    <p>
      It may have moved when the site was rebuilt. Go to the <a href="/">home page</a>, or straight to a
      project:
    </p>
    <ul class="links">
      {projects.map((p) => <li><a href={`/work/${p.slug}`}>{p.title}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    margin-top: clamp(2rem, 6vw, 5rem);
  }
  .not-found h1 {
    font-weight: 500;
    margin-bottom: 1.5rem;
  }
  .not-found p {
    max-width: 34rem;
    margin-bottom: 1rem;
  }
</style>
