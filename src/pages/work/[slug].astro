---
/*
  A project's own page, laid out like TransitTracker's service screen: the
  service in its line colour with its vehicle pulling in, the facts on a
  board panel, the screenshot on the ground below, the write-up as a
  stopping pattern, and the next service at the end.
*/
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Shot from '../../components/Shot.astro';
import Track from '../../components/Track.astro';
import Stops from '../../components/Stops.astro';
import { workImage } from '../../lib/images';
import { projects, adjacentProjects, hostname, liveLink } from '../../lib/profile';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { next } = adjacentProjects(project.slug);
const live = liveLink(project);

const gallery = (project.gallery ?? [])
  .map((g) => ({ ...g, src: workImage(g.image) }))
  .filter((g) => g.src);
const phoneShots = gallery.filter((g) => g.frame === 'phone');
const wideShots = gallery.filter((g) => g.frame !== 'phone');

const parts = [
  { title: 'The problem', body: project.problem },
  { title: 'How it works', body: project.approach },
  { title: 'Where it is now', body: project.outcome, now: true },
];
const theme = `--bg:${project.color};--fg:${project.ink}`;
---

<BaseLayout title={project.title} description={project.summary} color={project.color} ink={project.ink}>
  <article>
    <header class="band svc-head" style={theme}>
      <div class="page svc-head-inner">
        <div class="svc-name">
          <span class="svc-badge">{project.code}</span>
          <h1 class="svc-title" style={`view-transition-name:title-${project.slug}`}>{project.title}</h1>
        </div>
        <p class="svc-summary">{project.summary}</p>
        <dl class="svc-facts">
          <div>
            <dt>Year</dt>
            <dd class="svc-year">{project.year}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{project.role}</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>{project.tech.join(', ')}</dd>
          </div>
          {
            (live || project.repo) && (
              <div>
                <dt>Links</dt>
                <dd>
                  <ul class="links">
                    {live && <li><a href={live}>{hostname(live)}</a></li>}
                    {project.repo && <li><a href={project.repo}>Source on GitHub</a></li>}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
      <Track vehicle={project.vehicle} colour={project.color} mode="arrive" stop={0.5} />
    </header>

    {
      workImage(project.image) && (
        <div class="svc-cover">
          <div class="page">
            <Shot project={project} sizes="(max-width: 96rem) 92vw, 88rem" crop={false} eager />
          </div>
        </div>
      )
    }

    <div class="page svc-body">
      <Stops stops={parts} line={project.color} ground="var(--paper)" large />
    </div>

    {
      phoneShots.length > 0 && (
        <div class="svc-phones">
          <div class="page svc-phones-inner">
            {phoneShots.map((g) => (
              <figure>
                <Image src={g.src!} alt="" width={780} widths={[360, 540, 780]} sizes="(max-width: 48rem) 44vw, 20rem" class="shot" />
                <figcaption>{g.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )
    }

    {
      wideShots.map((g) => (
        <figure class="page svc-wide">
          <Image src={g.src!} alt="" width={1800} widths={[720, 1200, 1800]} sizes="(max-width: 96rem) 92vw, 88rem" class="shot" />
          <figcaption>{g.caption}</figcaption>
        </figure>
      ))
    }
  </article>

  <a class="band next" href={`/work/${next.slug}`} style={`--bg:${next.color};--fg:${next.ink}`}>
    <span class="page next-inner">
      <span class="next-badge">{next.code}</span>
      <span class="next-text">
        <span class="next-title">{next.title}</span>
        <span class="next-label">is the next service. {next.summary}</span>
      </span>
    </span>
    <Track vehicle={next.vehicle} colour={next.color} mode="arrive" stop={0.72} />
  </a>
</BaseLayout>

<style>
  /* ---- The service, in its line colour ---- */
  .svc-head {
    position: relative;
    z-index: 2;
  }
  .svc-head-inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(1.25rem, 3vw, 2.5rem) clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    padding-block: clamp(1rem, 4vw, 3rem) clamp(0.5rem, 2vw, 1.5rem);
  }
  .svc-name {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    min-width: 0;
  }
  .svc-badge,
  .next-badge {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(3rem, 8vw, 7.5rem);
    aspect-ratio: 1;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--label);
    font-weight: 700;
    font-size: clamp(1rem, 2.6vw, 2.5rem);
  }
  .svc-title {
    font-size: clamp(2.5rem, 0.5rem + 10vw, 12rem);
    line-height: 0.85;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .svc-summary {
    font-family: var(--pixel);
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 2.125rem);
    line-height: 1.25;
    max-width: 40rem;
  }

  /* The facts on a board panel, as the app shows a service's details. */
  .svc-facts {
    background: #0c0c0a;
    color: #f3ecd8;
    border: var(--stroke) solid #0c0c0a;
    outline: var(--stroke) solid #3d3d38;
    outline-offset: calc(var(--stroke) * -2);
    padding: 0.5rem 1.25rem;
  }
  .svc-facts > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .svc-facts > div + div {
    border-top: 2px dashed #3d3d38;
  }
  .svc-facts dt {
    font-family: var(--label);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: #a3a092;
    padding-top: 0.3em;
  }
  .svc-facts dd {
    font-family: var(--pixel);
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .svc-facts .svc-year {
    font-family: var(--digits);
    font-size: 1.5rem;
    line-height: 1;
  }
  .svc-facts .links {
    gap: 0.25rem 1.25rem;
    font-weight: 700;
  }
  .svc-facts a:hover {
    background: #f3ecd8;
    color: #0c0c0a;
  }

  /* ---- The screenshot, on the ground under the platform ---- */
  .svc-cover {
    background: #0c0c0a;
    padding-block: clamp(1rem, 3vw, 2.5rem) clamp(2.5rem, 6vw, 5rem);
  }
  .svc-cover :global(.shot) {
    border-color: #3d3d38;
  }

  .svc-body {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(1rem, 3vw, 2rem);
  }

  /* ---- More screens, on the board's ground ---- */
  .svc-phones {
    margin-top: clamp(2rem, 5vw, 4rem);
    background: #0c0c0a;
    color: #d9d2be;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .svc-phones-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--gap);
  }
  .svc-phones :global(.shot) {
    border-color: #3d3d38;
  }
  @media (min-width: 48rem) {
    .svc-phones-inner {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .svc-wide {
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  figcaption {
    margin-top: 0.75rem;
    max-width: 40rem;
    font-family: var(--pixel);
    font-size: 1rem;
    line-height: 1.4;
  }

  /* ---- The next service ---- */
  .next {
    display: block;
    margin-top: clamp(3rem, 7vw, 6rem);
    text-decoration: none;
  }
  .next:hover {
    background: var(--bg);
    color: var(--fg);
  }
  .next:hover .next-title {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }
  .next-inner {
    display: flex;
    align-items: flex-start;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(0.5rem, 2vw, 1.5rem);
  }
  .next-text {
    min-width: 0;
  }
  .next-title {
    display: block;
    font-family: var(--pixel);
    font-weight: 700;
    font-size: clamp(2.5rem, 0.5rem + 8vw, 9rem);
    line-height: 0.85;
    overflow-wrap: anywhere;
  }
  .next-label {
    display: block;
    margin-top: 1rem;
    max-width: 44rem;
    font-family: var(--pixel);
    font-size: clamp(1.125rem, 0.9rem + 0.6vw, 1.5rem);
    line-height: 1.3;
  }

  @media (max-width: 60rem) {
    .svc-head-inner {
      grid-template-columns: 1fr;
    }
    .svc-title,
    .next-title {
      font-size: clamp(1.9rem, 8.6vw, 5rem);
    }
  }
</style>
