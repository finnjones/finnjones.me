---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { workImage } from '../../lib/images';
import { projects, adjacentProjects, hostname, liveLink } from '../../lib/profile';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { prev, next } = adjacentProjects(project.slug);
const cover = workImage(project.image);

const gallery = (project.gallery ?? [])
  .map((g) => ({ ...g, src: workImage(g.image) }))
  .filter((g) => g.src);
const phoneShots = gallery.filter((g) => g.frame === 'phone');
const wideShots = gallery.filter((g) => g.frame !== 'phone');

const parts = [
  { heading: 'The problem', body: project.problem },
  { heading: 'How it works', body: project.approach },
  { heading: 'Where it is now', body: project.outcome },
];
const live = liveLink(project);
---

<BaseLayout title={project.title} description={project.summary}>
  <article>
    <header class="page grid case-head">
      <div class="case-intro">
        <h1 class="case-title">{project.title}</h1>
        <p class="lead">{project.summary}</p>
      </div>

      <dl class="case-facts">
        <div>
          <dt class="soft">Year</dt>
          <dd>{project.year}</dd>
        </div>
        <div>
          <dt class="soft">Role</dt>
          <dd>{project.role}</dd>
        </div>
        <div>
          <dt class="soft">Built with</dt>
          <dd>{project.tech.join(', ')}</dd>
        </div>
        {
          (live || project.repo) && (
            <div>
              <dt class="soft">Links</dt>
              <dd>
                <ul class="links">
                  {live && <li><a href={live}>{hostname(live)}</a></li>}
                  {project.repo && <li><a href={project.repo}>Source on GitHub</a></li>}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      cover && (
        <div class="page case-cover">
          <Image
            src={cover}
            alt={project.imageAlt ?? `Screenshot of ${project.title}.`}
            width={1800}
            widths={[720, 1200, 1800, 2400]}
            sizes="(max-width: 84rem) 92vw, 78rem"
            class="shot"
            loading="eager"
          />
        </div>
      )
    }

    <div class="page case-body">
      {
        parts.map((part) => (
          <section class="grid case-part">
            <h2 class="section-title side">{part.heading}</h2>
            <p class="main case-text">{part.body}</p>
          </section>
        ))
      }
    </div>

    {
      phoneShots.length > 0 && (
        <div class="page case-phones">
          {phoneShots.map((g) => (
            <figure>
              <Image
                src={g.src!}
                alt=""
                widths={[360, 540, 780]}
                sizes="(max-width: 48rem) 44vw, 19rem"
                class="shot"
              />
              <figcaption class="small soft">{g.caption}</figcaption>
            </figure>
          ))}
        </div>
      )
    }

    {
      wideShots.map((g) => (
        <figure class="page case-wide">
          <Image
            src={g.src!}
            alt=""
            width={1800}
            widths={[720, 1200, 1800]}
            sizes="(max-width: 84rem) 92vw, 78rem"
            class="shot"
          />
          <figcaption class="small soft">{g.caption}</figcaption>
        </figure>
      ))
    }
  </article>

  <nav class="page grid section case-nav" aria-label="Other projects">
    <p class="case-nav-prev">
      <span class="soft">Previous</span>
      <a href={`/work/${prev.slug}`}>{prev.title}</a>
    </p>
    <p class="case-nav-next">
      <span class="soft">Next</span>
      <a href={`/work/${next.slug}`}>{next.title}</a>
    </p>
  </nav>
</BaseLayout>

<style>
  .case-head {
    margin-top: clamp(2rem, 6vw, 5rem);
    row-gap: 2.5rem;
    align-items: start;
  }
  .case-title {
    font-size: var(--size-lead);
    margin-bottom: 0.35em;
  }
  .case-intro .lead {
    color: var(--ink-soft);
  }

  .case-facts > div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    column-gap: var(--gap);
    padding-block: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .case-facts > div:last-child {
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 60rem) {
    .case-intro {
      grid-column: 1 / span 7;
    }
    .case-facts {
      grid-column: 9 / span 4;
    }
  }

  .case-cover {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .case-body {
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  .case-part + .case-part {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .case-text {
    max-width: 40rem;
    font-size: var(--size-text);
    line-height: 1.55;
  }

  .case-phones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem var(--gap);
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  @media (min-width: 48rem) {
    .case-phones {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .case-wide {
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  figcaption {
    margin-top: 0.75rem;
    max-width: 40rem;
  }

  .case-nav {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    row-gap: 1rem;
  }
  .case-nav p {
    grid-column: span 6;
  }
  .case-nav span {
    display: block;
  }
  .case-nav a {
    font-size: var(--size-title);
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .case-nav-next {
    text-align: right;
  }
</style>
