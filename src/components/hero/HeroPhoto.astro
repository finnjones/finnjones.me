---
// Option 3. The photograph at full bleed, the name outlined across it, and
// the introduction on a block of yellow.
import { Image } from 'astro:assets';
import Nav from './Nav.astro';
import { portraitImage } from '../../lib/images';
import { profile } from '../../lib/profile';
---

<section class="picture">
  <div class="band picture-head">
    <div class="page"><Nav /></div>
  </div>
  <div class="picture-frame">
    <Image
      src={portraitImage}
      alt="Finn Jones in sunglasses and a cap, standing at a street market."
      width={2400}
      widths={[800, 1200, 1800, 2400]}
      sizes="100vw"
      class="picture-img"
      loading="eager"
    />
    <div class="page picture-inner">
      <div class="band picture-text">
        {profile.intro.map((para) => <p class="lead">{para}</p>)}
      </div>
      <h1 class="picture-name">{profile.name}</h1>
    </div>
  </div>
</section>

<style>
  .picture {
    display: flex;
    flex-direction: column;
    min-height: var(--hero-h, calc(100svh - var(--rail)));
  }
  .picture-head {
    --bg: var(--sun);
    border-bottom: var(--stroke) solid var(--ink);
  }
  .picture-frame {
    position: relative;
    flex: 1;
    display: flex;
    overflow: hidden;
    background: var(--ink);
  }
  .picture-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 38%;
  }
  .picture-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding-top: clamp(1.25rem, 3vw, 2.5rem);
  }
  .picture-text {
    --bg: var(--sun);
    max-width: 34rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: var(--stroke) solid var(--ink);
  }
  .picture-text .lead {
    font-size: clamp(1.125rem, 0.9rem + 0.7vw, 1.4375rem);
  }
  .picture-text .lead + .lead {
    margin-top: 0.75em;
  }
  /* Yellow letters with the same ink outline the sprites have. */
  .picture-name {
    margin-left: -0.03em;
    font-size: var(--size-giant);
    line-height: 0.8;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--sun);
    -webkit-text-stroke: clamp(4px, 0.7vw, 10px) var(--ink);
    paint-order: stroke fill;
    padding-bottom: 0.07em;
  }
  /* On a phone the text drops below the name so it does not cover the face. */
  @media (max-width: 59.99rem) {
    .picture-inner {
      justify-content: flex-end;
      gap: 0.5rem;
      padding-bottom: 1.25rem;
    }
    .picture-text {
      order: 2;
    }
    .picture-frame {
      min-height: 38rem;
    }
    .picture-img {
      object-position: 100% 0;
    }
  }
</style>
