---
// Option 4. The work on the wall: screenshots and the photograph pinned at
// angles beside the introduction, each one a link to its project.
import { Image } from 'astro:assets';
import Nav from './Nav.astro';
import { workImage, portraitImage } from '../../lib/images';
import { profile } from '../../lib/profile';

const pieces = [
  { cls: 'p-site', href: '/work/aglc4-citation-tool', src: workImage('aforecite.png'), label: 'Aforecite' },
  { cls: 'p-game', href: '/work/trigger-outlaws', src: workImage('triggeroutlaws.png'), label: 'Trigger Outlaws' },
  { cls: 'p-phone-a', href: '/work/transittracker', src: workImage('transittracker-home-night.png'), label: 'TransitTracker' },
  { cls: 'p-phone-b', href: '/work/transittracker', src: workImage('transittracker-service-live.png'), label: 'TransitTracker' },
];
---

<section class="wall band">
  <div class="page wall-inner">
    <Nav />
    <div class="wall-body">
      <div class="wall-text">
        {profile.intro.map((para) => <p class="lead">{para}</p>)}
      </div>
      <div class="wall-pieces">
        {
          pieces.map((p) => (
            <a class:list={['piece', p.cls]} href={p.href} aria-label={p.label}>
              <Image src={p.src!} alt="" width={900} widths={[300, 600, 900]} sizes="(max-width: 60rem) 45vw, 30vw" class="shot" loading="eager" />
            </a>
          ))
        }
        <span class="piece p-photo">
          <Image
            src={portraitImage}
            alt="Finn Jones in sunglasses and a cap, standing at a street market."
            width={640}
            widths={[320, 640]}
            sizes="(max-width: 60rem) 30vw, 14vw"
            class="shot"
            loading="eager"
          />
        </span>
      </div>
    </div>
    <h1 class="wall-name">{profile.name}</h1>
  </div>
</section>

<style>
  .wall {
    --bg: var(--sun);
    display: flex;
    min-height: var(--hero-h, calc(100svh - var(--rail)));
    overflow: hidden;
  }
  .wall-inner {
    display: flex;
    flex-direction: column;
  }
  .wall-body {
    flex: 1;
    display: grid;
    gap: 2rem var(--gap);
    align-items: start;
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .wall-text .lead + .lead {
    margin-top: 0.75em;
  }
  .wall-name {
    margin-left: -0.045em;
    font-size: var(--size-giant);
    line-height: 0.8;
    letter-spacing: -0.06em;
    white-space: nowrap;
    padding-bottom: 0.08em;
  }

  /* Pieces are placed by percentage inside a box with a fixed shape, so the
     arrangement holds at every width. */
  .wall-pieces {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 7;
  }
  .piece {
    position: absolute;
    display: block;
  }
  a.piece:hover {
    background: none;
    z-index: 5;
    transform: rotate(0deg) scale(1.04);
  }
  .piece :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .p-site {
    left: 0;
    top: 6%;
    width: 62%;
    aspect-ratio: 16 / 10;
    transform: rotate(-3deg);
  }
  .p-game {
    left: 14%;
    top: 52%;
    width: 44%;
    aspect-ratio: 16 / 10;
    z-index: 2;
    transform: rotate(4deg);
  }
  .p-phone-a {
    left: 60%;
    top: 0;
    width: 22%;
    aspect-ratio: 780 / 1688;
    z-index: 3;
    transform: rotate(5deg);
  }
  .p-phone-b {
    left: 79%;
    top: 18%;
    width: 21%;
    aspect-ratio: 780 / 1688;
    z-index: 2;
    transform: rotate(-4deg);
  }
  .p-photo {
    left: 50%;
    top: 62%;
    width: 21%;
    aspect-ratio: 4 / 5;
    z-index: 4;
    transform: rotate(-6deg);
  }
  .p-photo :global(img) {
    object-position: 78% 40%;
  }

  @media (min-width: 60rem) {
    .wall-body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .wall-pieces {
      /* Never taller than the room the name leaves. */
      width: min(100%, 46svh * 1.43);
      justify-self: end;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .piece {
      transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
</style>
