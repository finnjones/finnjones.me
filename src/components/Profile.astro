---
import { Image } from 'astro:assets';
import { profile } from '../lib/profile';
import { portraitImage } from '../lib/images';
---

<section class="section profile" id="profile">
  <div class="wrap">
    <div class="section-head">
      <span class="section-idx">02</span>
      <h2 class="section-title" data-split>Profile</h2>
    </div>

    <div class="profile-grid">
      <div class="profile-statement">
        <p class="profile-lead" data-split>
          Computer Science <span class="serif">and</span> Commerce. Engineering at a lending
          company, with a <span class="serif">working</span> fluency in markets and money.
        </p>
        <div class="profile-about" data-reveal>
          {profile.about.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <figure class="profile-portrait" data-reveal>
        <Image
          src={portraitImage}
          alt={`Portrait of ${profile.name}`}
          widths={[320, 480, 640]}
          sizes="(max-width: 880px) 60vw, 360px"
          class="portrait-img"
        />
        <figcaption class="mono-sm muted">
          <span class="accent">●</span> {profile.name.toUpperCase()} — {profile.location.toUpperCase()}
        </figcaption>
      </figure>
    </div>

    <!-- Counters -->
    <div class="counters" data-stagger>
      {
        profile.metrics.map((m) => (
          <div class="counter">
            <span class="counter-mono mono-sm muted">{m.mono}</span>
            <span class="counter-value tabular">
              {m.prefix}
              {typeof m.value === 'number' && m.value > 0 ? (
                <span data-count={m.value}>0</span>
              ) : (
                <span>{m.text}</span>
              )}
              {m.suffix}
            </span>
            <span class="counter-label muted">{m.label}</span>
          </div>
        ))
      }
    </div>

    <!-- Capabilities matrix -->
    <div class="caps" data-stagger>
      {
        profile.capabilities.map((c) => (
          <div class="cap">
            <h3 class="cap-head mono-sm">
              <span class="accent">+</span> {c.label}
            </h3>
            <ul class="cap-list">
              {c.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .profile-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }
  .profile-lead {
    font-size: var(--fs-h3);
    font-weight: 480;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 2rem;
    max-width: 24ch;
  }
  .profile-lead .serif {
    font-size: 1.15em;
  }
  .profile-about {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--muted);
    max-width: 52ch;
    font-size: var(--fs-body);
  }

  .profile-portrait {
    position: sticky;
    top: calc(var(--bar-h) + 1.5rem);
  }
  .portrait-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 82% 42%;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    filter: grayscale(0.55) contrast(1.02);
    transition: filter 0.5s var(--ease-out);
  }
  .profile-portrait:hover .portrait-img {
    filter: grayscale(0);
  }
  .profile-portrait figcaption {
    margin-top: 0.75rem;
  }

  .counters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .counter {
    background: var(--bg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .counter-value {
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 660;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .counter-label {
    font-size: 0.85rem;
  }

  .caps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
  }
  .cap-head {
    margin-bottom: 0.9rem;
    color: var(--fg);
    letter-spacing: 0.08em;
  }
  .cap-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .cap-list li {
    padding-left: 1rem;
    position: relative;
  }
  .cap-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 5px;
    height: 1px;
    background: var(--muted);
  }

  @media (max-width: 880px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }
    .profile-portrait {
      position: static;
      max-width: 260px;
      order: -1;
    }
  }
  @media (max-width: 560px) {
    .counters {
      grid-template-columns: 1fr;
    }
  }
</style>
