---
import { profile } from '../lib/profile';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Background and text colour of the band at the top of the page. */
  color?: string;
  ink?: string;
}

const {
  title,
  description = profile.description,
  image = '/og.png',
  color = 'var(--sun)',
  ink = 'var(--ink)',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === '';
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name}, software engineer in Sydney`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before first paint: cover the first page of a visit with the loading screen.
      // If the loader script never runs, the page uncovers itself after 10 seconds.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var seen = false;
        try { seen = sessionStorage.getItem('fj-seen') === '1'; } catch (e) {}
        if (!seen) {
          d.classList.add('loading');
          setTimeout(function () { d.classList.remove('loading'); }, 10000);
        }
      })();
    </script>
    <style is:inline>
      .loader { display: none; }
      html.loading { overflow: hidden; }
      html.loading .loader {
        position: fixed; inset: 0; z-index: 1000;
        display: grid; place-items: center;
        background: #0c0c0a; color: #f3ecd8;
      }
    </style>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/pixelify-sans-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/doto-black.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0d0d0d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        jobTitle: profile.headline,
        url: 'https://finnjones.me',
        email: `mailto:${profile.email}`,
        address: { '@type': 'PostalAddress', addressLocality: profile.location },
        sameAs: profile.socials.filter((s) => s.label !== 'Email').map((s) => s.url),
      })}
    />
  </head>

  <body>
    <div class="loader" data-loader aria-hidden="true">
      <div class="loader-inner">
        <div class="loader-window"><canvas></canvas></div>
        <p class="loader-name" data-flap>{profile.name}</p>
        <div class="loader-cars">
          {Array.from({ length: 12 }, () => <span />)}
        </div>
      </div>
    </div>

    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-head band" style={`--bg:${color};--fg:${ink}`}>
      <div class="page site-head-inner">
        {isHome ? <span class="site-name">finnjones.me</span> : <a class="site-name" href="/">{profile.name}</a>}
        <nav aria-label="Main">
          <ul class="links">
            <li><a href="/#work">Work</a></li>
            <li><a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot band" id="contact">
      <div class="page">
        <h2 class="foot-title">Say hello</h2>
        <p class="foot-email"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <ul class="links foot-links">
          {profile.socials.filter((s) => s.label !== 'Email').map((s) => <li><a href={s.url}>{s.label}</a></li>)}
        </ul>
      </div>
      <div class="harbour" aria-hidden="true">
        <span class="sprite ferry"></span>
      </div>
      <div class="foot-base small">
        <div class="page foot-base-inner">
          <p>© {year} {profile.name}, {profile.location}</p>
          <p>The train and the ferry are sprites from <a href="/work/transittracker">TransitTracker</a>.</p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/loader';
    </script>

    <style>
      /* ---- The loading screen (see src/scripts/loader.ts) ---- */
      .loader-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(1.25rem, 3vh, 2rem);
      }
      .loader-window {
        line-height: 0;
        padding: 6px;
        background: #181816;
        border: 3px solid #3d3d38;
      }
      .loader-window canvas {
        display: block;
        image-rendering: pixelated;
      }
      .loader-name {
        display: flex;
        gap: 4px;
        font-family: var(--label);
        font-weight: 700;
        font-size: clamp(1.5rem, 0.6rem + 3vw, 3.25rem);
        line-height: 1;
        color: #f3ecd8;
      }
      /* Split-flap cells, each with its hinge across the middle. */
      .loader-name :global(.flap) {
        position: relative;
        display: inline-grid;
        place-items: center;
        width: 1.15em;
        height: 1.45em;
        background: #181816;
      }
      .loader-name :global(.flap)::after {
        content: '';
        position: absolute;
        inset: 50% 0 auto 0;
        height: 2px;
        background: #0c0c0a;
      }
      .loader-name :global(.flap.gap) {
        width: 0.5em;
        background: none;
      }
      .loader-cars {
        display: flex;
        gap: 6px;
      }
      .loader-cars span {
        width: 14px;
        height: 14px;
        background: #3d3d38;
      }
      .loader-cars span:global(.on) {
        background: #f3ecd8;
      }
      .loader:global(.is-leaving) .loader-inner {
        opacity: 0;
        transition: opacity 0.2s steps(3);
      }

      .site-head {
        position: relative;
        z-index: 2;
        font-family: var(--label);
        font-size: 0.875rem;
        letter-spacing: 0.06em;
      }
      .site-head-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 2rem;
        padding-block: clamp(0.9rem, 1.8vw, 1.4rem);
      }
      .site-name {
        font-weight: 700;
        text-decoration: none;
      }
      .site-head nav a {
        display: inline-block;
        padding: 0.375rem 0.125rem;
        text-decoration: none;
      }
      .site-head nav a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-thickness: 0.1em;
      }

      /* ---- Footer: the harbour ---- */
      .site-foot {
        --bg: var(--sky);
        --fg: var(--ink);
        --u: calc(var(--px) * 2);
        position: relative;
        z-index: 2;
        padding-top: clamp(4rem, 9vw, 8rem);
        overflow: hidden;
      }
      .foot-title {
        font-size: var(--size-title);
      }
      .foot-email {
        margin-top: 1.5rem;
        font-size: clamp(1.375rem, 0.6rem + 3.6vw, 4rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        overflow-wrap: anywhere;
      }
      .foot-links {
        margin-top: 1.25rem;
        font-size: var(--size-lead);
      }
      /* Sky above, sea below. A row of sprite-sized waves marks the surface
         and the ferry sits on it. */
      .harbour {
        position: relative;
        height: calc(var(--u) * 22);
        margin-top: clamp(2rem, 5vw, 4rem);
      }
      .harbour::after {
        content: '';
        position: absolute;
        inset: auto 0 0 0;
        height: calc(var(--u) * 4);
        background: var(--sea);
      }
      .harbour::before {
        content: '';
        position: absolute;
        inset: auto 0 calc(var(--u) * 4) 0;
        height: calc(var(--u) * 2);
        background: url('/sprites/wave.png') repeat-x;
        background-size: auto 100%;
        image-rendering: pixelated;
      }
      .ferry {
        position: absolute;
        left: 0;
        bottom: var(--u);
        z-index: 1;
        width: calc(var(--u) * 34);
        height: calc(var(--u) * 18);
        background-image: url('/sprites/ferry.png');
        transform: translateX(12vw);
      }
      .foot-base {
        --bg: var(--sea);
        background: var(--sea);
      }
      .foot-base-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.25rem 2rem;
        padding-block: 1rem 1.75rem;
      }
    </style>
  </body>
</html>
