---
import { ClientRouter } from 'astro:transitions';
import { profile } from '../lib/profile';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noFooter?: boolean;
  wide?: boolean;
}

const {
  title,
  description = `${profile.name} — ${profile.headline}. ${profile.positioning}`,
  image = '/og.png',
  noFooter = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} — ${profile.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0c0c0b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- No-flash theme: run before paint -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ledger-theme');
          if (t === 'paper') document.documentElement.setAttribute('data-theme', 'paper');
        } catch (e) {}
        try {
          if (sessionStorage.getItem('ledger-visited') === '1')
            document.documentElement.setAttribute('data-preloaded', '1');
        } catch (e) {}
      })();
    </script>

    <ClientRouter />

    <!-- JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        jobTitle: profile.headline,
        url: 'https://finnjones.me',
        email: `mailto:${profile.email}`,
        address: { '@type': 'PostalAddress', addressLocality: profile.location },
        sameAs: profile.socials.filter((s) => s.label !== 'Email').map((s) => s.url),
      })}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- First-visit odometer preloader -->
    <div class="preloader" data-preloader aria-hidden="true">
      <div class="preloader-inner">
        <span class="preloader-mono mono-sm">LEDGER · LOADING</span>
        <span class="preloader-num tabular" data-preloader-num>000</span>
      </div>
      <div class="preloader-bar"><span data-preloader-fill></span></div>
    </div>

    <!-- Custom cursor -->
    <div class="cursor-ring" data-cursor-ring></div>
    <div class="cursor-dot" data-cursor-dot></div>

    <TopBar />

    <main id="main" transition:animate="fade">
      <slot />
    </main>

    {!noFooter && <Footer />}

    <!-- Click-to-copy toast -->
    <div class="toast mono-sm" data-toast role="status" aria-live="polite">
      COPIED TO CLIPBOARD <span class="accent">✓</span>
    </div>

    <script>
      import '../scripts/main.ts';
    </script>

    <style>
      .preloader {
        position: fixed;
        inset: 0;
        z-index: 9000;
        background: var(--bg);
        display: grid;
        place-content: center;
        gap: 1.2rem;
        transition: opacity 0.5s var(--ease-out), visibility 0.5s;
      }
      .preloader[data-done='true'] {
        opacity: 0;
        visibility: hidden;
      }
      /* Returning visitor (this session): never flash the loader */
      :global(:root[data-preloaded]) .preloader {
        opacity: 0;
        visibility: hidden;
        transition: none;
      }
      .preloader-inner {
        display: flex;
        align-items: baseline;
        gap: 1.2rem;
        justify-content: center;
      }
      .preloader-mono {
        color: var(--muted);
      }
      .preloader-num {
        font-family: var(--font-display);
        font-size: clamp(3rem, 12vw, 8rem);
        font-weight: 680;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--fg);
      }
      .preloader-bar {
        width: min(60vw, 320px);
        height: 2px;
        background: var(--rule);
        overflow: hidden;
      }
      .preloader-bar span {
        display: block;
        height: 100%;
        width: 0%;
        background: var(--accent);
        transition: width 0.1s linear;
      }

      .toast {
        position: fixed;
        left: 50%;
        bottom: 2rem;
        transform: translate(-50%, 160%);
        z-index: 8000;
        background: var(--fg);
        color: var(--bg);
        padding: 0.7rem 1.1rem;
        border-radius: var(--radius);
        box-shadow: 0 10px 40px var(--shadow);
        transition: transform 0.45s var(--ease-expo);
        pointer-events: none;
      }
      .toast[data-show='true'] {
        transform: translate(-50%, 0);
      }
    </style>
  </body>
</html>
