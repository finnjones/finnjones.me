---
import { profile } from '../lib/profile';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Background and text colour of the band at the top of the page. */
  color?: string;
  ink?: string;
}

const {
  title,
  description = profile.description,
  image = '/og.png',
  color = 'var(--sun)',
  ink = 'var(--ink)',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const isHome = path === '';
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name}, software engineer in Sydney`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0d0d0d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        jobTitle: profile.headline,
        url: 'https://finnjones.me',
        email: `mailto:${profile.email}`,
        address: { '@type': 'PostalAddress', addressLocality: profile.location },
        sameAs: profile.socials.filter((s) => s.label !== 'Email').map((s) => s.url),
      })}
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="rail" aria-hidden="true">
      <span class="sprite train"></span>
    </div>

    <header class="site-head band" style={`--bg:${color};--fg:${ink}`}>
      <div class="page site-head-inner">
        {isHome ? <span /> : <a class="site-name" href="/">{profile.name}</a>}
        <nav aria-label="Main">
          <ul class="links">
            <li><a href="/#work">Work</a></li>
            <li><a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot band" id="contact">
      <div class="page">
        <h2 class="foot-title">Say hello</h2>
        <p class="foot-email"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <ul class="links foot-links">
          {profile.socials.filter((s) => s.label !== 'Email').map((s) => <li><a href={s.url}>{s.label}</a></li>)}
        </ul>
      </div>
      <div class="harbour" aria-hidden="true">
        <span class="sprite ferry"></span>
      </div>
      <div class="foot-base small">
        <div class="page foot-base-inner">
          <p>© {year} {profile.name}, {profile.location}</p>
          <p>The train and the ferry are sprites from <a href="/work/transittracker">TransitTracker</a>.</p>
        </div>
      </div>
    </footer>

    <style>
      .site-head {
        position: relative;
        z-index: 2;
        padding-top: var(--rail);
      }
      .site-head-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 2rem;
        padding-block: clamp(1rem, 2.5vw, 1.75rem);
      }
      .site-name {
        font-weight: 800;
        letter-spacing: -0.02em;
        text-decoration: none;
      }
      .site-head nav a {
        display: inline-block;
        padding: 0.375rem 0.125rem;
        text-decoration: none;
      }
      .site-head nav a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-thickness: 0.1em;
      }

      /* ---- Footer: the harbour ---- */
      .site-foot {
        --bg: var(--sky);
        --fg: var(--ink);
        --u: calc(var(--px) * 2);
        position: relative;
        z-index: 2;
        padding-top: clamp(4rem, 9vw, 8rem);
        overflow: hidden;
      }
      .foot-title {
        font-size: var(--size-title);
      }
      .foot-email {
        margin-top: 1.5rem;
        font-size: clamp(1.375rem, 0.6rem + 3.6vw, 4rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.1;
        overflow-wrap: anywhere;
      }
      .foot-links {
        margin-top: 1.25rem;
        font-size: var(--size-lead);
      }
      /* Sky above, sea below. A row of sprite-sized waves marks the surface
         and the ferry sits on it. */
      .harbour {
        position: relative;
        height: calc(var(--u) * 22);
        margin-top: clamp(2rem, 5vw, 4rem);
      }
      .harbour::after {
        content: '';
        position: absolute;
        inset: auto 0 0 0;
        height: calc(var(--u) * 4);
        background: var(--sea);
      }
      .harbour::before {
        content: '';
        position: absolute;
        inset: auto 0 calc(var(--u) * 4) 0;
        height: calc(var(--u) * 2);
        background: url('/sprites/wave.png') repeat-x;
        background-size: auto 100%;
        image-rendering: pixelated;
      }
      .ferry {
        position: absolute;
        left: 0;
        bottom: var(--u);
        z-index: 1;
        width: calc(var(--u) * 34);
        height: calc(var(--u) * 18);
        background-image: url('/sprites/ferry.png');
        transform: translateX(12vw);
      }
      .foot-base {
        --bg: var(--sea);
        background: var(--sea);
      }
      .foot-base-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.25rem 2rem;
        padding-block: 1rem 1.75rem;
      }
    </style>
  </body>
</html>
